@model AnimalSanctuary.Models.Animal
@{
    ViewData["Title"] = "Edit " + Model.Name;
}

<div class="page-head">
    <div class="page-icon"><i class="bi bi-pencil"></i></div>
    <div>
        <h1>Edit "@Model.Name"</h1>
        <p class="page-subtitle">Update the animal card</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-ghost"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="panel">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="form-grid">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SpeciesId" class="form-label"></label>
                        <select asp-for="SpeciesId" class="form-select" asp-items="ViewBag.SpeciesId">
                            <option value="">-- Select species --</option>
                        </select>
                        <span asp-validation-for="SpeciesId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Breed" class="form-label"></label>
                        <input asp-for="Breed" class="form-control" />
                        <span asp-validation-for="Breed" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AgeMonths" class="form-label"></label>
                        <input asp-for="AgeMonths" class="form-control" type="number" />
                        <span asp-validation-for="AgeMonths" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" class="form-select" asp-items="ViewBag.Gender">
                            <option value="">-- Select gender --</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HealthStatus" class="form-label"></label>
                        <select asp-for="HealthStatus" class="form-select" asp-items="ViewBag.HealthStatus">
                            <option value="">-- Select health status --</option>
                        </select>
                        <span asp-validation-for="HealthStatus" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select" asp-items="ViewBag.Status">
                            <option value="">-- Select status --</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="mb-3 d-flex align-items-end pb-3">
                        <div class="form-check">
                            <input asp-for="IsSterilized" class="form-check-input" />
                            <label asp-for="IsSterilized" class="form-check-label"></label>
                        </div>
                    </div>

                    <div class="mb-3 span-2">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-taupe px-4"><i class="bi bi-check2 me-1"></i> Save Changes</button>
                    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
