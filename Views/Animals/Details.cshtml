@model AnimalSanctuary.Models.Animal
@{
    ViewData["Title"] = Model.Name;
    bool isStaff = User.IsInRole("Manager") || User.IsInRole("Administrator");
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
    var badgeClass = Model.Status == "Available" ? "badge-available"
                   : Model.Status == "Reserved" ? "badge-reserved"
                   : "badge-adopted";
}

<div class="page-head">
    <div class="page-icon"><i class="bi bi-heart-pulse"></i></div>
    <div>
        <h1>@Model.Name</h1>
        <p class="page-subtitle">@Model.Species?.Name @(string.IsNullOrEmpty(Model.Breed) ? "" : "· " + Model.Breed)</p>
    </div>
    <div class="page-actions">
        <a href="/#catalog" class="btn btn-ghost"><i class="bi bi-arrow-left me-1"></i> Back to Catalog</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="panel p-3">
            <img src="@(Model.PhotoUrl ?? "/images/animals/paw.svg")" alt="@Model.Name" class="details-photo"
                 onerror="this.onerror=null;this.src='/images/animals/paw.svg';" />
            <div class="d-flex gap-2 mt-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Favorites" asp-action="Toggle" method="post" class="flex-grow-1">
                        <input type="hidden" name="animalId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-ghost w-100">
                            <i class="bi bi-heart me-1"></i> Add to Favorites
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Details", "Animals", new { id = Model.Id })"
                       class="btn btn-ghost flex-grow-1">
                        <i class="bi bi-heart me-1"></i> Login to save Favorites
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge badge-soft @badgeClass">@Model.Status</span>
                <span class="text-muted small">Added on @Model.CreatedAt.ToString("dd.MM.yyyy")</span>
            </div>

            <dl class="row details-dl mb-0">
                <dt class="col-sm-4">Species</dt>
                <dd class="col-sm-8">@Model.Species?.Name</dd>

                <dt class="col-sm-4">Breed</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Breed) ? "-" : Model.Breed)</dd>

                <dt class="col-sm-4">Age</dt>
                <dd class="col-sm-8">@Model.AgeYears yr. (@Model.AgeMonths mo.)</dd>

                <dt class="col-sm-4">Gender</dt>
                <dd class="col-sm-8">@Model.Gender</dd>

                <dt class="col-sm-4">Health status</dt>
                <dd class="col-sm-8">@Model.HealthStatus</dd>

                <dt class="col-sm-4">Sterilized</dt>
                <dd class="col-sm-8">@(Model.IsSterilized ? "Yes" : "No")</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@Model.Description</dd>
            </dl>

            <hr class="mt-4" />

            @if (Model.Status == "Available")
            {
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="AdoptionRequests" asp-action="Create" asp-route-animalId="@Model.Id" class="btn btn-taupe btn-lg w-100">
                        <i class="bi bi-pencil-square me-1"></i> Apply for Adoption / Visit
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Details", "Animals", new { id = Model.Id })"
                       class="btn btn-taupe btn-lg w-100">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Login to apply for Adoption / Visit
                    </a>
                    <p class="text-muted small mt-2 mb-0 text-center">Only registered users can submit applications.</p>
                }
            }
            else
            {
                <button class="btn btn-taupe btn-lg w-100" disabled>
                    <i class="bi bi-slash-circle me-1"></i> Applications closed - the animal is @Model.Status.ToLower()
                </button>
            }
        </div>

        @if (isStaff)
        {
            <div class="panel d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-ghost"><i class="bi bi-pencil me-1"></i> Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-soft-danger"><i class="bi bi-trash me-1"></i> Delete</a>
            </div>
        }
    </div>
</div>
