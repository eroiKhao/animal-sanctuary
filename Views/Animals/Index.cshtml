@model IEnumerable<AnimalSanctuary.Models.Animal>
@{
    ViewData["Title"] = "Animal Catalog";
}

<h1>Animal Catalog</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Add New Animal</a>
</p>
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Photo</th>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>Species</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>
                <img src="@(item.PhotoUrl ?? "/images/animals/paw.svg")" alt="@item.Name"
                     style="width:70px;height:56px;object-fit:cover;border-radius:8px;" />
            </td>
            <td>@item.Name</td>
            <td>@item.Species?.Name</td>
            <td>@item.AgeYears yr. (@item.AgeMonths mo.)</td>
            <td>@item.Gender</td>
            <td>
                <span class="badge @(item.Status == "Available" ? "bg-success" : item.Status == "Reserved" ? "bg-warning text-dark" : "bg-secondary")">
                    @item.Status
                </span>
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a><span> | </span>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a><span> | </span>
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
