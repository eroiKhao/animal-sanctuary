@model AnimalSanctuary.Models.AdoptionRequest
@{
    var animal = (AnimalSanctuary.Models.Animal)ViewBag.Animal;
    ViewData["Title"] = "Apply for " + animal.Name;
}

<div class="page-head">
    <div class="page-icon"><i class="bi bi-pencil-square"></i></div>
    <div>
        <h1>Application for "@animal.Name"</h1>
        <p class="page-subtitle">Fill in the questionnaire - our manager will contact you within 1-2 days</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Animals" asp-action="Details" asp-route-id="@animal.Id" class="btn btn-ghost">
            <i class="bi bi-arrow-left me-1"></i> Back to Profile
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="panel p-3">
            <img src="@(animal.PhotoUrl ?? "/images/animals/paw.svg")" alt="@animal.Name" class="details-photo"
                 onerror="this.onerror=null;this.src='/images/animals/paw.svg';" />
            <h5 class="mt-3 mb-1">@animal.Name</h5>
            <p class="text-muted small mb-2">@animal.Species?.Name @(string.IsNullOrEmpty(animal.Breed) ? "" : "· " + animal.Breed)</p>
            <p class="small mb-2">
                <i class="bi bi-balloon"></i> @animal.AgeYears yr.
                <span class="mx-1">&middot;</span>
                <i class="bi bi-gender-ambiguous"></i> @animal.Gender
            </p>
            <span class="badge badge-soft badge-available">@animal.Status</span>
        </div>
    </div>

    @* ----- The questionnaire ----- *@
    <div class="col-lg-8">
        <div class="panel">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="AnimalId" />

                <div class="form-grid">
                    <div class="mb-3">
                        <label class="form-label">Request type <span class="text-danger">*</span></label>
                        <select asp-for="RequestType" class="form-select">
                            <option value="">-- Select request type --</option>
                            <option value="Adoption">Adopt to Family</option>
                            <option value="Visit">Introductory Visit / Walk</option>
                        </select>
                        <span asp-validation-for="RequestType" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">Contact phone <span class="text-danger">*</span></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+380..." />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Living conditions <span class="text-danger">*</span></label>
                        <select asp-for="HousingType" class="form-select">
                            <option value="">-- Select housing type --</option>
                            <option value="Apartment">Apartment</option>
                            <option value="House">Private House</option>
                        </select>
                        <span asp-validation-for="HousingType" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PreferredVisitDate" class="form-label">Preferred visit date <span class="text-danger">*</span></label>
                        <input asp-for="PreferredVisitDate" class="form-control" type="date" />
                        <span asp-validation-for="PreferredVisitDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3 span-2">
                        <div class="form-check">
                            <input asp-for="HasOtherPets" class="form-check-input" />
                            <label asp-for="HasOtherPets" class="form-check-label">I already have other pets at home</label>
                        </div>
                    </div>

                    <div class="mb-3 span-2">
                        <label asp-for="ApplicantComment" class="form-label">Comment (optional)</label>
                        <textarea asp-for="ApplicantComment" class="form-control" rows="3"
                                  placeholder="Tell us a few words about your family and living conditions..."></textarea>
                        <span asp-validation-for="ApplicantComment" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-taupe px-4"><i class="bi bi-send me-1"></i> Submit Application</button>
                    <a asp-controller="Animals" asp-action="Details" asp-route-id="@animal.Id" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
