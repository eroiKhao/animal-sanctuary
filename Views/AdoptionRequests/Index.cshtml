@model IEnumerable<AnimalSanctuary.Models.AdoptionRequest>
@{
    ViewData["Title"] = "Applications";
}

<h1>Submitted Applications</h1>

@if (TempData["RequestSuccess"] != null)
{
    <div class="alert alert-success">@TempData["RequestSuccess"]</div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-file-earmark-text" style="font-size: 3rem; color: #adb5bd;"></i>
        <h4 class="mt-3">No applications yet</h4>
        <p class="text-muted">Open an animal card and press "Submit an Application".</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Animal</th>
                        <th>Applicant</th>
                        <th>Type</th>
                        <th>Phone</th>
                        <th>Housing</th>
                        <th>Visit date</th>
                        <th>Status</th>
                        <th>Comment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var badgeClass = r.Status == "Pending" ? "bg-warning text-dark"
                                       : r.Status == "Approved" ? "bg-success"
                                       : "bg-secondary";
                        <tr>
                            <td>@r.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <a asp-controller="Animals" asp-action="Details" asp-route-id="@r.AnimalId">
                                    @r.Animal?.Name
                                </a>
                            </td>
                            <td>@r.ApplicantName</td>
                            <td>@r.RequestType</td>
                            <td>@r.PhoneNumber</td>
                            <td>@r.HousingType</td>
                            <td>@r.PreferredVisitDate.ToString("dd.MM.yyyy")</td>
                            <td><span class="badge @badgeClass">@r.Status</span></td>
                            <td class="small text-muted">
                                @r.ApplicantComment
                                @if (!string.IsNullOrEmpty(r.ManagerComment))
                                {
                                    <br /><span class="text-success"><i class="bi bi-chat-quote"></i> @r.ManagerComment</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
