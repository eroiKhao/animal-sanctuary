@model IEnumerable<AnimalSanctuary.Models.Species>
@{
    ViewData["Title"] = "Species";
}

<h1>Species Directory</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Add New Species</a>
</p>
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Name</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a><span> | </span>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a><span> | </span>
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
