@model IEnumerable<AnimalSanctuary.Models.Species>
@{
    ViewData["Title"] = "Species";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Species Directory</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Species
    </a>
</div>
<p class="text-muted">Species are used to group animals in the catalog and in the filters.</p>

<div class="row g-4">
@foreach (var item in Model)
{
    <div class="col-md-3 col-sm-6">
        <div class="card animal-card h-100 shadow-sm text-center">
            <div class="card-body py-4">
                <i class="bi bi-collection display-6 text-success"></i>
                <h5 class="card-title mt-3">@item.Name</h5>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm mt-2">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm mt-2">Delete</a>
            </div>
        </div>
    </div>
}
</div>
