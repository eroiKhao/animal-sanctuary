@model AnimalSanctuary.Models.Species
@{
    ViewData["Title"] = "Add New Species";
}

<div class="page-head">
    <div class="page-icon"><i class="bi bi-plus-circle"></i></div>
    <div>
        <h1>Add New Species</h1>
        <p class="page-subtitle">Create a new category for the catalog</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-ghost"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="panel">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Species name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Reptiles" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-taupe px-4"><i class="bi bi-check2 me-1"></i> Save</button>
                    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
