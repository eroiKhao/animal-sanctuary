@model AnimalSanctuary.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="auth-wrap">
    <div class="auth-card text-center">
        <div class="auth-icon mx-auto"><i class="bi bi-exclamation-triangle"></i></div>
        <h1 class="h4 mb-2">Oops - something went wrong</h1>
        <p class="text-muted small mb-4">
            We could not process your request. Please try again later.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-taupe w-100 py-2">
            <i class="bi bi-house me-1"></i> Back to Home Page
        </a>
    </div>
    @if (Model?.ShowRequestId ?? false)
    {
        <p class="text-center text-muted small mt-3">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
