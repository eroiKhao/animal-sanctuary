@{
    ViewData["Title"] = "Access Denied";
}

<div class="auth-wrap">
    <div class="auth-card text-center">
        <div class="auth-icon mx-auto"><i class="bi bi-shield-lock"></i></div>
        <h1 class="h4 mb-2">Access denied</h1>
        <p class="text-muted small mb-4">
            You do not have permission to open this page.
            This section is available only to shelter staff.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-taupe w-100 py-2">
            <i class="bi bi-house me-1"></i> Back to Home Page
        </a>
    </div>
</div>
