@{
    ViewData["Title"] = "Contact";
}

<h1>Contact Us</h1>
<p class="lead">We are always happy to answer your questions and welcome new visitors.</p>

<div class="row g-4 mt-1">
    <div class="col-md-3 col-sm-6">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body">
                <i class="bi bi-geo-alt display-6 text-success"></i>
                <h5 class="card-title mt-2">Address</h5>
                <p class="card-text mb-0">12 Friendship Street,<br />Khmelnitskiy, Ukraine</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body">
                <i class="bi bi-clock display-6 text-success"></i>
                <h5 class="card-title mt-2">Working hours</h5>
                <p class="card-text mb-0">Monday - Saturday<br />9:00 - 18:00</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body">
                <i class="bi bi-telephone display-6 text-success"></i>
                <h5 class="card-title mt-2">Phone</h5>
                <p class="card-text mb-0">+380 (00) 123-45-67</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body">
                <i class="bi bi-envelope display-6 text-success"></i>
                <h5 class="card-title mt-2">Email</h5>
                <p class="card-text mb-0">hello@animalsanctuary.ua</p>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-light border shadow-sm mt-4">
    <i class="bi bi-info-circle text-success"></i>
    Before visiting the shelter, please <strong>call us in advance</strong> -
    our staff will prepare the animals for introduction and meet you at the entrance.
</div>
