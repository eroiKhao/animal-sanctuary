@model IEnumerable<AnimalSanctuary.Models.Favorite>
@{
    ViewData["Title"] = "My Favourites";
}

@if (TempData["FavoriteMessage"] != null)
{
    <div class="alert alert-info">@TempData["FavoriteMessage"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">My Favourites</h1>
    <a asp-controller="Animals" asp-action="Index" class="btn btn-primary">
        <i class="bi bi-grid-3x3-gap"></i> Go to Catalog
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-heart" style="font-size: 3rem; color: #adb5bd;"></i>
        <h4 class="mt-3">Your favourites list is empty</h4>
        <p class="text-muted">Open the catalog and press the heart button on any animal card to save it here.</p>
    </div>
}
else
{
    <p class="text-muted">
        <i class="bi bi-heart-fill text-danger"></i>
        You have @Model.Count() favourite animal(s).
    </p>

    <div class="row g-4">
    @foreach (var fav in Model)
    {
        var item = fav.Animal!;
        var badgeClass = item.Status == "Available" ? "badge-available"
                       : item.Status == "Reserved" ? "badge-reserved"
                       : "badge-adopted";

        <div class="col-md-4 col-sm-6">
            <div class="card animal-card h-100 shadow-sm">
                <img src="@(item.PhotoUrl ?? "/images/animals/paw.svg")" alt="@item.Name" class="animal-photo"
                     onerror="this.onerror=null;this.src='/images/animals/paw.svg';" />
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">@item.Name</h5>
                        <span class="badge @badgeClass">@item.Status</span>
                    </div>
                    <p class="text-muted mb-1 mt-2">
                        <i class="bi bi-tag"></i> @item.Species?.Name
                        @if (!string.IsNullOrEmpty(item.Breed))
                        {
                            <span>&middot; @item.Breed</span>
                        }
                    </p>
                    <p class="mb-3">
                        <i class="bi bi-balloon"></i> @item.AgeYears yr.
                        <span class="mx-1">&middot;</span>
                        <i class="bi bi-gender-ambiguous"></i> @item.Gender
                    </p>
                    <a asp-controller="Animals" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                        <i class="bi bi-eye"></i> Details
                    </a>
                    <form asp-controller="Favorites" asp-action="Toggle" method="post" class="d-inline">
                        <input type="hidden" name="animalId" value="@item.Id" />
                        <input type="hidden" name="returnUrl" value="/Favorites" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-heart-fill"></i> Remove
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    </div>
}
