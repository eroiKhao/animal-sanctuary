@model IEnumerable<AnimalSanctuary.Models.Favorite>
@{
    ViewData["Title"] = "My Favorites";
}

<div class="page-head">
    <div class="page-icon"><i class="bi bi-heart-fill"></i></div>
    <div>
        <h1>My Favorites</h1>
        <p class="page-subtitle">Animals you have saved for later: @Model.Count()</p>
    </div>
    <div class="page-actions">
        <a href="/#catalog" class="btn btn-taupe"><i class="bi bi-plus-circle me-1"></i> Find More Animals</a>
    </div>
</div>

@if (Model.Any())
{
    <partial name="_AnimalCards" model="Model.Select(f => f.Animal!)" />
}
else
{
    <div class="panel empty-state">
        <i class="bi bi-heart"></i>
        <p class="mt-2 mb-2">Your favorites list is empty.</p>
        <a href="/#catalog" class="btn btn-taupe">Browse the Catalog</a>
    </div>
}
